{
  "name": "image-generation-cli",
  "version": "0.1.0",
  "description": "基于 GPT Image API 的命令行图片生成与编辑工具",
  "type": "module",
  "bin": {
    "image-generation": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "openai",
    "image-generation",
    "image-edit",
    "cli"
  ],
  "dependencies": {
    "commander": "^15.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  }
}
